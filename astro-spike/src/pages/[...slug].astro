---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";

// Mirrors the existing content/<section>/[year]/[slug].md.ts dynamic routes.
export async function getStaticPaths() {
  const sections = ["blog", "lab"] as const;
  const paths = [];
  for (const section of sections) {
    const entries = await getCollection(section);
    for (const entry of entries) {
      paths.push({ params: { slug: `${section}/${entry.id}` }, props: { entry } });
    }
  }
  return paths;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title ?? entry.id} description={entry.data.description}>
  <Content />
</Base>
