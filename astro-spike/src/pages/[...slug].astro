---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { entryPath } from "../lib/entry-path";

// Mirrors the Observable site's content/<section>/[year]/[slug].md.ts routes,
// so the published URLs stay identical.
export async function getStaticPaths() {
  const sections = ["blog", "lab"] as const;
  const paths = [];
  for (const section of sections) {
    const entries = await getCollection(section);
    for (const entry of entries) {
      paths.push({
        params: { slug: entryPath(section, entry.id, entry.data.date).slice(1) },
        props: { entry },
      });
    }
  }
  return paths;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base
  title={entry.data.title ?? entry.id}
  description={entry.data.description}
  contentPath={entry.filePath?.replace(/^src\/content\//, "content/")}
>
  <Content />
</Base>
