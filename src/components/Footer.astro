---
import { site, sourceUrl } from "../lib/site";

interface Props {
  /** Repository relative path of the page source, when there is one. */
  contentPath?: string;
}
const { contentPath } = Astro.props;

const now = new Date();
const buildTime = now.toISOString().replace("T", " ").slice(0, 19);
const buildUrl = site.runId ? `${site.homepage}/actions/runs/${site.runId}` : undefined;
const source = sourceUrl(contentPath);
---

<footer class="site-footer">
  <hr />
  <p>
    {/* As above: the space survives only while it sits on the same line as the
        expression that follows it. */}
    Last build {buildUrl
      ? <a href={buildUrl} target="_blank" rel="noopener noreferrer">{buildTime} UTC</a>
      : <span>{buildTime} UTC</span>}
  </p>
  {source && (
    <p>
      {/* One line on purpose: inside an expression Astro follows JSX and trims
          the newline, which swallowed the space after "on". */}
      Source code available on <a href={source} target="_blank" rel="noopener noreferrer">github</a>
    </p>
  )}
  <p>&copy; {site.firstYear}&ndash;{now.getUTCFullYear()} {site.author}</p>
</footer>
