---
/**
 * Credits for every photo in the image registry, generated from
 * src/data/images.json. Registering a photo with the images loader credits it
 * here without editing the credits page.
 *
 * The registry carries no photographer name, so each photo links to its page
 * on the provider, which names the photographer.
 */
import images from "../data/images.json";

interface Photo {
  id: string;
  provider: string;
  thumbnail: string;
  page: string;
}

const PROVIDERS: Record<string, string> = { unsplash: "Unsplash", pixabay: "Pixabay" };

/**
 * The provider page URL ends with a readable slug followed by the photo id, as
 * in unsplash.com/photos/solar-eclipse-with-diamond-ring-effect-_ok8uVzL2gI, so
 * the slug doubles as a description. Pages with no slug fall back to the name.
 */
const describe = (name: string, photo: Photo): string => {
  const last = new URL(photo.page).pathname.split("/").filter(Boolean).pop() ?? "";
  const slug = last.endsWith(photo.id) ? last.slice(0, -photo.id.length).replace(/-+$/, "") : "";
  const text = slug.replace(/-/g, " ").trim();
  return text ? text.charAt(0).toUpperCase() + text.slice(1) : name;
};

const photos = Object.entries(images as Record<string, Photo>)
  .map(([name, photo]) => ({
    name,
    page: photo.page,
    thumbnail: photo.thumbnail,
    description: describe(name, photo),
    provider: PROVIDERS[photo.provider] ?? photo.provider,
  }))
  .sort((a, b) => a.description.localeCompare(b.description));
---

<ul class="image-credits">
  {photos.map((photo) => (
    <li>
      <a href={photo.page} target="_blank" rel="noopener">
        <img src={photo.thumbnail} alt={photo.description} loading="lazy" />
        <span class="description">{photo.description}</span>
        <span class="provider">{photo.provider}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .image-credits {
    list-style: none;
    padding: 0;
    margin: 1rem 0 2rem;
    max-width: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 1rem;
  }
  .image-credits li { margin: 0; }
  .image-credits a { display: flex; flex-direction: column; gap: 0.25rem; color: var(--foreground); }
  .image-credits a:hover { text-decoration: none; }
  .image-credits a:hover .description { color: var(--accent); }
  .image-credits img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--foreground-fainter);
  }
  .image-credits .description { font-size: 0.85rem; line-height: 1.3; }
  .image-credits .provider { font-size: 0.75rem; color: var(--foreground-faint); }
</style>
