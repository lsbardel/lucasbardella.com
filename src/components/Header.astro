---
/**
 * Top header: site title, search and the theme toggle.
 *
 * Observable Framework gave both of these for free (`search: true` plus a fixed
 * dark theme). Astro ships neither, so both are rebuilt here.
 *
 * Search is Pagefind's Component UI, which registers a self rendering
 * `pagefind-searchbox` custom element. Its assets are generated by
 * `pagefind --site dist` after the Astro build, so they only exist in a built
 * site and are requested only there.
 */
---

<header class="site-header">
  <a href="/" class="brand">Luca Sbardella</a>

  <div class="search">
    <pagefind-searchbox></pagefind-searchbox>
  </div>

  <div class="theme-toggle" role="group" aria-label="Colour theme">
    <button type="button" data-set-theme="light" title="Light" aria-label="Light">☀</button>
    <button type="button" data-set-theme="system" title="System" aria-label="System">◐</button>
    <button type="button" data-set-theme="dark" title="Dark" aria-label="Dark">☾</button>
  </div>
</header>

<script is:inline src="/pagefind/pagefind-component-ui.js" type="module"></script>

<script>
  // Theme state lives in the inline script in Base.astro so it can run before
  // first paint. The buttons only hand it the new preference.
  for (const button of document.querySelectorAll<HTMLElement>("[data-set-theme]")) {
    button.addEventListener("click", () => {
      (window as unknown as { __setTheme: (p: string) => void }).__setTheme(button.dataset.setTheme!);
    });
  }
</script>
